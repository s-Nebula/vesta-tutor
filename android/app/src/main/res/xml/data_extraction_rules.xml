<?xml version="1.0" encoding="utf-8"?>
<!--
  Sin copias en la nube ni transferencias entre dispositivos (Android 12+).
  Las preferencias guardan reglas de filtrado y estado de vinculación: si se
  pudieran extraer y restaurar, se podrían manipular las protecciones.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
